{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dylankuhlenthal/porch/schemas/list.schema.json",
  "title": "Porch list output (schema 1)",
  "type": "object",
  "required": ["schema", "sessions", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "sessions": { "type": "array", "items": { "$ref": "observation.schema.json" } },
    "errors": {
      "description": "One entry per adapter whose listing failed; its sessions are missing from sessions.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["harness", "message"],
        "additionalProperties": false,
        "properties": {
          "harness": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
